# ============================================================
# TEJAS INSTITUTE OF ADVANCED TECHNOLOGY
# Environment Configuration Template
# ============================================================

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="TEJAS Institute of Advanced Technology"
NEXT_PUBLIC_CAMPUS_LOCATION="Bhubaneswar, Odisha, India"

# Supabase Public (Client-safe)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Supabase Server-Only (NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# Cloudflare R2 Object Storage (Server-Only - NEVER expose to browser)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=tejas-institute-storage
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-your-id.r2.dev

# Payment Gateway (Abstraction Provider: 'sandbox' | 'razorpay' | 'stripe')
PAYMENT_PROVIDER=sandbox
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
STRIPE_SECRET_KEY=sk_test_placeholder
